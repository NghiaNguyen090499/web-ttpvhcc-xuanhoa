# ============================================================
# Cấu hình môi trường - TTPVHCC Xuân Hòa
# Copy file này thành .env và điền giá trị thực
# ============================================================

# --- Database (Self-host PostgreSQL) ---
# Nếu Next.js chạy cùng server DB:
DATABASE_URL="postgresql://xuanhoa_app:change-this-long-random-password@127.0.0.1:5432/xuanhoa?schema=public"
# Nếu deploy app ở Vercel, dùng host/IP private/public đã firewall chặt:
# DATABASE_URL="postgresql://xuanhoa_app:change-this-long-random-password@your-db-host:5432/xuanhoa?schema=public&sslmode=require"

NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAILS="admin@xuanhoa.gov.vn"

# --- Seed tài khoản quản trị nội bộ ---
SEED_ADMIN_EMAIL="admin@xuanhoa.gov.vn"
SEED_ADMIN_PASSWORD="change-this-admin-password"

# --- Google Gemini AI (Chatbot) ---
GEMINI_API_KEY="your-gemini-api-key"

# --- Uploads ---
# Local dev mặc định ghi vào /tmp/xuanhoa-uploads; production Docker dùng /app/uploads.
UPLOAD_DIR=""

# --- Bảo mật (AES-256-GCM field encryption) ---
ENCRYPTION_KEY="chuoi-bi-mat-toi-thieu-32-ky-tu-thay-doi-trong-production"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TTPVHCC Phường Xuân Hòa"
