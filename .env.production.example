# ============================================================
# Production env - self-host server
# Copy thành .env.production trên server và điền giá trị thật.
# Không commit file .env.production.
# ============================================================

# --- Docker/PostgreSQL ---
POSTGRES_DB=xuanhoa
POSTGRES_USER=xuanhoa_app
POSTGRES_PASSWORD=change-this-long-random-db-password
POSTGRES_PORT=127.0.0.1:5432
APP_PORT=127.0.0.1:3000

# App container kết nối DB qua service name "postgres"
DATABASE_URL=postgresql://xuanhoa_app:change-this-long-random-db-password@postgres:5432/xuanhoa?schema=public

# --- Domain/App ---
NEXTAUTH_URL=https://your-domain.vn
NEXT_PUBLIC_APP_URL=https://your-domain.vn
NEXT_PUBLIC_APP_NAME=TTPVHCC Phường Xuân Hòa
NEXTAUTH_SECRET=change-this-very-long-random-secret
ENCRYPTION_KEY=change-this-at-least-32-characters-secret

# --- Admin seed ---
SEED_ADMIN_EMAIL=admin@xuanhoa.gov.vn
SEED_ADMIN_PASSWORD=change-this-admin-password
ADMIN_EMAILS=admin@xuanhoa.gov.vn

# --- Supabase Storage for CMS uploads ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=portal-uploads

# --- Chatbot AI ---
GEMINI_API_KEY=your-gemini-api-key
