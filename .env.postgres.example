# Copy thành .env.postgres trên server DB và đổi tất cả giá trị bí mật.

POSTGRES_DB=xuanhoa
POSTGRES_USER=xuanhoa_app
POSTGRES_PASSWORD=change-this-long-random-password

# Mặc định chỉ bind localhost. Nếu app chạy máy khác, dùng firewall/VPN rồi đổi thành 5432 hoặc private IP.
POSTGRES_PORT=127.0.0.1:5432
